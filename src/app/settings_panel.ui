		<property name="styleSheet">
			<string notr="true">QDialog { background-color: #2a2a2a; color: #ffffff; }
QWidget { background-color: #2a2a2a; color: #ffffff; }
QLabel { color: #ffffff; }
QCheckBox { color: #ffffff; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #555555; border-radius: 3px; background-color: #333333; }
QCheckBox::indicator:checked { background-color: #4a6ef0; border-color: #4a6ef0; }
QSpinBox { background-color: #333333; color: #ffffff; border: 1px solid #444444; border-radius: 4px; padding: 4px; }
QComboBox { background-color: #333333; color: #ffffff; border: 1px solid #444444; border-radius: 4px; padding: 6px; min-width: 120px; }
QComboBox::drop-down { width: 20px; border: none; }
QPushButton { background-color: #333333; color: #ffffff; border: 1px solid #444444; border-radius: 4px; padding: 8px 16px; min-width: 60px; }
QPushButton:hover { background-color: #444444; }
QPushButton:pressed { background-color: #555555; }
QPushButton:checked { background-color: #4a6ef0; border-color: #4a6ef0; }
#navWidget { background-color: #222222; }
#navWidget QPushButton { background-color: transparent; color: #cccccc; border: none; border-left: 3px solid transparent; text-align: left; padding: 12px 16px; font-size: 14px; }
#navWidget QPushButton:hover { background-color: #333333; color: #ffffff; }
#navWidget QPushButton:checked { background-color: #2a2a2a; color: #ffffff; border-left-color: #4a6ef0; }
#contentWidget { background-color: #2a2a2a; }
#contentWidget QLabel { font-size: 13px; }</string>
