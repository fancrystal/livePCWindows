  <property name="styleSheet">
   <string notr="true">QDialog { background-color: #2a2a2a; color: #ffffff; }
QWidget { background-color: #2a2a2a; color: #ffffff; font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif; font-size: 14px; }
QPushButton { background-color: #333333; color: #ffffff; border: 1px solid #444444; border-radius: 8px; padding: 10px 20px; font-weight: 500; }
QPushButton:hover { background-color: #444444; border-color: #4a6ef0; }
QPushButton:pressed { background-color: #555555; }
QPushButton:checked { background-color: #333333; border-color: #4a6ef0; color: #4a6ef0; font-weight: 600; }
QLabel { color: #ffffff; font-weight: 500; }
QCheckBox { color: #ffffff; spacing: 8px; }
QCheckBox::indicator { width: 20px; height: 20px; border: 2px solid #444444; border-radius: 4px; background-color: #333333; }
QCheckBox::indicator:hover { border-color: #4a6ef0; }
QCheckBox::indicator:checked { background-color: #4a6ef0; border-color: #4a6ef0; }
QCheckBox::indicator:checked::after { content: '✓'; color: #2a2a2a; font-weight: bold; }
QComboBox { background-color: #333333; color: #ffffff; border: 1px solid #444444; border-radius: 6px; padding: 8px 12px; min-height: 32px; combobox-popup: 0; }
QComboBox:hover { border-color: #4a6ef0; }
QComboBox:focus { border-color: #4a6ef0; }
QComboBox::drop-down { width: 20px; border: none; }
QComboBox::down-arrow { image: url(:/images/Frame_Tri.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #333333; border: 1px solid #444444; border-radius: 6px; selection-background-color: #444444; selection-color: #ffffff; outline: none; }
QComboBox QAbstractItemView::item { padding: 8px 12px; min-height: 28px; }
QComboBox QAbstractItemView::item:hover { background-color: #444444; }
QStackedWidget { background-color: #2a2a2a; border: 1px solid #444444; border-radius: 8px; }
/* 左侧标签按钮样式 */
#leftPanel QPushButton { background-color: transparent; color: #cccccc; border: none; border-right: 3px solid transparent; padding: 14px 16px; text-align: left; font-size: 14px; font-weight: 500; }
#leftPanel QPushButton:hover { background-color: #333333; color: #ffffff; }
#leftPanel QPushButton:checked { background-color: #333333; border-right: 3px solid #4a6ef0; color: #4a6ef0; font-weight: 600; }</string>
